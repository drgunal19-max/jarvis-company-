# Display name shown in the browser and API.
APP_NAME=JARVIS Company AI
# Use development locally. Deploy only behind an HTTPS proxy.
APP_ENV=development
# SQLite database path. Use persistent storage in deployment.
DATABASE_URL=sqlite:///./jarvis.db
# How often the enabled backend scheduler checks task due times.
POLL_INTERVAL_MINUTES=30
# Enable only on one application instance.
ENABLE_SCHEDULER=false
# Set a long random value before exposing the API or connecting n8n.
APP_API_TOKEN=
# Optional OpenAI-compatible provider. Prompts are sent to this provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional Tavily key for user-requested web searches in chat.
TAVILY_API_KEY=
# WhatsApp Cloud API credentials; use Meta app/system-user secrets, never commit real values.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
# Google Workspace read-only OAuth; generate the Fernet key with the README command.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Instagram API with Instagram Login (professional accounts; read-only profile/media)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/instagram/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_GRAPH_API_VERSION=v25.0
